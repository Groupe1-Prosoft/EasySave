<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:EasySave.AvaloniaApp.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
		x:Class="EasySave.AvaloniaApp.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Title="EasySave"
		MinWidth="900" MinHeight="600"
		Width="1100" Height="700"
		Background="#FAFAFA"
		ExtendClientAreaToDecorationsHint="True"
		ExtendClientAreaChromeHints="PreferSystemChrome"
		ExtendClientAreaTitleBarHeightHint="40">

	<Window.Styles>
		<!-- Nav button base style -->
		<Style Selector="Button.nav-btn">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#64748B"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="14,10"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Margin" Value="6,2"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.nav-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#EDE9FE"/>
			<Setter Property="Foreground" Value="#6366F1"/>
		</Style>
		<Style Selector="Button.nav-btn.active">
			<Setter Property="Background" Value="#EDE9FE"/>
			<Setter Property="Foreground" Value="#6366F1"/>
		</Style>
		<Style Selector="Button.nav-btn.active /template/ ContentPresenter">
			<Setter Property="Background" Value="#EDE9FE"/>
			<Setter Property="Foreground" Value="#6366F1"/>
		</Style>

		<!-- Lang button style -->
		<Style Selector="Button.lang-btn">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#64748B"/>
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="MinWidth" Value="32"/>
		</Style>
		<Style Selector="Button.lang-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#EDE9FE"/>
			<Setter Property="Foreground" Value="#6366F1"/>
		</Style>
		<Style Selector="Button.lang-btn.active">
			<Setter Property="Background" Value="#6366F1"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="Button.lang-btn.active /template/ ContentPresenter">
			<Setter Property="Background" Value="#6366F1"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
	</Window.Styles>

	<DockPanel>
		<!-- Title Bar -->
		<Border DockPanel.Dock="Top" Background="#FAFAFA" Height="40"
				IsHitTestVisible="True" Name="TitleBar">
			<Grid ColumnDefinitions="Auto,*,Auto">
				<!-- Logo + Title -->
				<StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
					<Border Background="#6366F1" CornerRadius="6" Padding="6,3" Margin="0,0,8,0">
						<TextBlock Text="ES" Foreground="White" FontWeight="Bold" FontSize="13"/>
					</Border>
					<TextBlock Text="EasySave" FontWeight="SemiBold" FontSize="14" Foreground="#1E1E1E"
							   VerticalAlignment="Center"/>
				</StackPanel>

				<!-- Language Switcher -->
				<StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,140,0"
							VerticalAlignment="Center" Spacing="4">
					<Button Classes="lang-btn"
							Command="{Binding SwitchLanguageCommand}"
							CommandParameter="fr" Content="FR"/>
					<Button Classes="lang-btn"
							Command="{Binding SwitchLanguageCommand}"
							CommandParameter="en" Content="EN"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- SplitView -->
		<SplitView IsPaneOpen="{Binding IsPaneOpen}"
				   DisplayMode="CompactInline"
				   CompactPaneLength="56"
				   OpenPaneLength="200"
				   PaneBackground="#F3F0FF">

			<SplitView.Pane>
				<DockPanel Margin="0,8">
					<!-- Hamburger button -->
					<Button DockPanel.Dock="Top"
							Classes="nav-btn"
							Command="{Binding TogglePaneCommand}"
							Margin="6,0,6,8">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<TextBlock Text="&#9776;" FontSize="18" Width="24" TextAlignment="Center"/>
						</StackPanel>
					</Button>

					<!-- Navigation buttons -->
					<StackPanel DockPanel.Dock="Top" Spacing="2">
						<Button Classes="nav-btn"
								Command="{Binding NavigateCommand}"
								CommandParameter="Home">
							<StackPanel Orientation="Horizontal" Spacing="12">
								<TextBlock Text="&#127968;" FontSize="16" Width="24" TextAlignment="Center"/>
								<TextBlock Text="{Binding Loc[NavHome]}" IsVisible="{Binding IsPaneOpen}"/>
							</StackPanel>
						</Button>

						<Button Classes="nav-btn"
								Command="{Binding NavigateCommand}"
								CommandParameter="Settings">
							<StackPanel Orientation="Horizontal" Spacing="12">
								<TextBlock Text="&#9881;" FontSize="16" Width="24" TextAlignment="Center"/>
								<TextBlock Text="{Binding Loc[NavSettings]}" IsVisible="{Binding IsPaneOpen}"/>
							</StackPanel>
						</Button>
					</StackPanel>

					<!-- Spacer -->
					<Panel/>
				</DockPanel>
			</SplitView.Pane>

			<!-- Page Content -->
			<Border Background="#FAFAFA" Padding="0">
				<ContentControl Content="{Binding CurrentPage}" Margin="0"/>
			</Border>

		</SplitView>
	</DockPanel>
</Window>
